  year     = {2026},
  pdf      = {https://openreview.net/pdf?id=FP2XNyV9WL},
  preview  = {bindweave.png},
  selected = {true},
  abstract = {BindWeave is a unified subject-to-video generation framework for both single-subject and complex multi-subject scenarios. It uses an MLLM-DiT architecture to ground visual subjects and disentangle their roles, attributes, and interactions.}
}

@inproceedings{li2026a3point,
  abbr     = {ICLR},
  title    = {Adaptive Augmentation-Aware Latent Learning for Robust LiDAR Semantic Segmentation},
  author   = {Li, Wangkai and Li, Zhaoyang and Pan, Yuwen and Sun, Rui and Chen, Yujia and Zhang, Tianzhu},
  booktitle = {International Conference on Learning Representations},
  year     = {2026},
